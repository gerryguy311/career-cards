{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-cards",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Workers AI writes the one-line "why this card" reasons.
  "ai": { "binding": "AI" },
  // Caps AI calls per visitor IP: 20 per minute.
  "ratelimits": [
    {
      "name": "EXPLAIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
